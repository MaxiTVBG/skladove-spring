---
title: Class диаграма — домейн модел (JPA entity-та)
---
classDiagram
  direction TB

  class AppUser {
    <<entity>>
    -Long id
    -String username
    -String password
    -String fullName
    -String email
    -String phone
    -Role role
    -BigDecimal fee
    -Double rating
  }
  class Notification {
    <<entity>>
    -Long id
    -AppUser recipient
    -Type type
    -String message
    -boolean read
    -LocalDateTime createdAt
  }
  class Warehouse {
    <<entity>>
    -Long id
    -String name
    -String address
    -Double area
    -Double height
    -String climateConditions
    -String goodsType
    -String category
    -BigDecimal monthlyPrice
    -WarehouseStatus status
    -AppUser owner
    -Set~AppUser~ agents
  }
  class RentalContract {
    <<entity>>
    -Long id
    -Warehouse warehouse
    -AppUser agent
    -AppUser decidedBy
    -String tenantName
    -String tenantPhone
    -String tenantEmail
    -LocalDate startDate
    -LocalDate endDate
    -BigDecimal price
    -RentalStatus status
    -LocalDate createdAt
    -LocalDateTime decidedAt
    -String decisionNote
    #onCreate() void
  }
  class AgentRating {
    <<entity>>
    -Long id
    -AppUser agent
    -AppUser owner
    -RentalContract rentalContract
    -Integer score
    -String comment
    -LocalDateTime createdAt
    #onCreate() void
  }

  class Role {
    <<enumeration>>
    ADMIN
    OWNER
    AGENT
  }
  class WarehouseStatus {
    <<enumeration>>
    AVAILABLE
    RENTED
    MAINTENANCE
    INACTIVE
  }
  class RentalStatus {
    <<enumeration>>
    PENDING_OWNER_APPROVAL
    ACTIVE
    REJECTED
    COMPLETED
    CANCELLED
  }
  class Type {
    <<enumeration>>
    NEW_RENTAL_REQUEST
    WAREHOUSE_RENTED
    CONTRACT_EXPIRING
  }

  AppUser "1" -- "0..*" Warehouse : притежава (owner)
  AppUser "0..*" -- "0..*" Warehouse : обслужва (agents)
  Warehouse "1" -- "0..*" RentalContract : договори
  AppUser "1" -- "0..*" RentalContract : създава заявка (agent)
  AppUser "0..1" -- "0..*" RentalContract : одобрява / отхвърля (decidedBy)
  AppUser "1" -- "0..*" Notification : получава (recipient)
  AppUser "1" -- "0..*" AgentRating : получава оценка (agent)
  AppUser "1" -- "0..*" AgentRating : оценява (owner)
  RentalContract "1" -- "0..1" AgentRating : оценка (rentalContract)

  AppUser ..> Role
  Warehouse ..> WarehouseStatus
  RentalContract ..> RentalStatus
  Notification ..> Type : вложен enum Notification.Type

  %% синьо = модули на Човек A, зелено = модули на Човек B, жълто = enum
  style AppUser fill:#DEEBF7,stroke:#2F5597,stroke-width:2px
  style Notification fill:#DEEBF7,stroke:#2F5597,stroke-width:2px
  style Warehouse fill:#E2F0D9,stroke:#548235,stroke-width:2px
  style RentalContract fill:#E2F0D9,stroke:#548235,stroke-width:2px
  style Role fill:#FFF2CC,stroke:#BF9000
  style WarehouseStatus fill:#FFF2CC,stroke:#BF9000
  style RentalStatus fill:#FFF2CC,stroke:#BF9000
  style Type fill:#FFF2CC,stroke:#BF9000
